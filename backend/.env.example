# Backend
# If port 8080 is in use by another service, change this and set BACKEND_PORT to
# the same value so the Vite dev server proxy forwards to the right port:
#   PORT=8081 go run ./cmd/server   (in one terminal)
#   BACKEND_PORT=8081 npm run dev   (in another terminal)
PORT=8080
BACKEND_BIND_ADDR=127.0.0.1
FRONTEND_ORIGIN=http://localhost:5173
QUOTE_HISTORY_LIMIT=1000
MAX_REQUEST_BODY_BYTES=1048576

# Optional API protection.
# Required if BACKEND_BIND_ADDR is set to a public interface such as 0.0.0.0.
API_TOKEN=

# Optional AI provider.
# The app works without this key and falls back to a local rule-based assistant.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# HTTP server timeouts.
HTTP_READ_TIMEOUT=10s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
